---
import Base from "../../../layouts/Base.astro";
import BuyBlock from "../../../components/BuyBlock.astro";
import Icon from "../../../components/Icon.astro";
import PicksBlock from "../../../components/PicksBlock.astro";
import ProductArt from "../../../components/ProductArt.astro";
import ProductCard from "../../../components/ProductCard.astro";
import { categoryBySlug, copy } from "../../../config/active";
import { formatDate, getKit, type Entry } from "../../../lib/kit";

export async function getStaticPaths() {
  const kit = await getKit();
  return kit.map((entry) => ({
    params: { category: entry.data.category, product: entry.id },
    props: { entry, related: kit.filter((e) => e.data.category === entry.data.category && e.id !== entry.id).slice(0, 4) },
  }));
}

interface Props {
  entry: Entry;
  related: Entry[];
}

const { entry, related } = Astro.props;
const { data } = entry;
const category = categoryBySlug(data.category);
const reviewed = data.reviewed.toISOString().slice(0, 10);

// The write-up folds into one panel per "## Heading" section, so the page leads
// with the picture, the facts and the buy button, and the detail is a tap away.
const sections = (entry.rendered?.html ?? "")
  .split(/(?=<h2[\s>])/)
  .filter((part) => part.trim())
  .map((part) => {
    const match = /^<h2[^>]*>([\s\S]*?)<\/h2>([\s\S]*)$/.exec(part.trim());
    return match ? { heading: match[1], body: match[2] } : { heading: copy.entry.detailsHeading, body: part };
  });
---

<Base title={data.title} description={data.summary} ogType="article">
  <article class="pdp">
    <div class="container">
      <p class="crumbs">
        <a href="/kit/">All kit</a><span aria-hidden="true">›</span><a href={`/kit/${category.slug}/`}>{category.name}</a>
      </p>
      <div class="pdp-top">
        <div class="pdp-media">
          <ProductArt entry={entry} hero />
        </div>
        <div class="pdp-info">
          <p class={`pdp-eyebrow tone-${category.tone}`}>{category.name}</p>
          <h1 class="pdp-title">{data.product}</h1>
          <p class="pdp-sub">{data.title}</p>
          {
            data.highlights && (
              <ul class="highlights" aria-label={copy.entry.highlightsLabel}>
                {data.highlights.map((highlight) => (
                  <li>
                    <Icon name="check" />
                    {highlight}
                  </li>
                ))}
              </ul>
            )
          }
          {data.asin && <BuyBlock asin={data.asin} product={data.product} class="pdp-buy" />}
          {
            data.picks && (
              <a class="button button-block pdp-buy" href="#picks">
                {copy.entry.seePicks}
              </a>
            )
          }
          <p class="pdp-meta">
            <span class:list={["badge", data.experience]}>
              {data.experience === "owned" ? copy.entry.owned : copy.entry.researched}
            </span>
            <span>
              {copy.entry.reviewed} <time datetime={reviewed}>{formatDate(data.reviewed)}</time>
            </span>
          </p>
          {data.experience === "researched" && <p class="pdp-note">{copy.entry.researchedNote}</p>}
          {
            data.health && (
              <p class="pdp-health">
                <a href="#health">{copy.entry.healthShort}</a>
              </p>
            )
          }
        </div>
      </div>
    </div>

    {
      data.picks && (
        <div class="container">
          <PicksBlock picks={data.picks} />
        </div>
      )
    }

    <section class="section section-alt pdp-more">
      <div class="container narrow">
        <div class="drawback-card">
          <Icon name="balance" />
          <div>
            <h2>{copy.entry.drawbackHeading}</h2>
            <p>{data.drawback}</p>
          </div>
        </div>

        <h2 class="shelf-title details-title">{copy.entry.detailsHeading} <span>{copy.entry.detailsSub}</span></h2>
        <div class="accordion">
          {
            data.health && (
              <details class="acc" id="health" open>
                <summary>
                  <h3>{copy.entry.healthHeading}</h3>
                </summary>
                <div class="acc-body">
                  <p>{copy.entry.healthLead}</p>
                  <p>{data.healthNote}</p>
                </div>
              </details>
            )
          }
          {
            sections.map((section) => (
              <details class="acc">
                <summary>
                  <h3 set:html={section.heading} />
                </summary>
                <div class="acc-body prose" set:html={section.body} />
              </details>
            ))
          }
        </div>

        {
          data.asin && (
            <div class="buy-end">
              <div>
                <p class="buy-end-name">{data.product}</p>
                <p class="buy-end-sub">{data.title}</p>
              </div>
              <BuyBlock asin={data.asin} product={data.product} />
            </div>
          )
        }
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="section">
          <div class="container">
            <h2 class="shelf-title">
              {copy.entry.relatedHeading} {category.name}.
            </h2>
            <ul class="product-grid related">
              {related.map((other) => (
                <ProductCard entry={other} showCategory={false} />
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </article>
</Base>
