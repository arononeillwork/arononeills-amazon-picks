---
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import ProductTile from "../../../components/ProductTile.astro";
import { getKit, getShelves } from "../../../lib/kit";

export async function getStaticPaths() {
  const { categories } = await getShelves();
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const entries = (await getKit()).filter((entry) => entry.data.category === category.slug);
---

<Base title={category.name} description={category.intro}>
  <header class="container page-head">
    <p class="crumbs"><a href="/kit/">All kit</a></p>
    <Icon name={category.slug} />
    <h1 class="page-title">{category.name}</h1>
    <p class="page-sub">{category.intro}</p>
  </header>
  <div class="container">
    <ul class="product-grid">
      {entries.map((entry) => <ProductTile entry={entry} showCategory={false} />)}
    </ul>
  </div>
  <div class="section-spacer" aria-hidden="true"></div>
</Base>
