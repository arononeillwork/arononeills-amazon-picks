---
import Base from "../../../layouts/Base.astro";
import EntryRow from "../../../components/EntryRow.astro";
import { catalogue } from "../../../config/active";
import { getKit } from "../../../lib/kit";

export function getStaticPaths() {
  return catalogue.categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const entries = (await getKit()).filter((entry) => entry.data.category === category.slug);
---

<Base title={category.name} description={category.intro}>
  <p class="crumbs"><a href="/kit/">All kit</a></p>
  <h1>{category.name}</h1>
  <p class="lead">{category.intro}</p>
  <ul class="entries">
    {entries.map((entry) => <EntryRow entry={entry} showCategory={false} />)}
  </ul>
</Base>
