---
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import ProductArt from "../../../components/ProductArt.astro";
import ProductCard from "../../../components/ProductCard.astro";
import { getKit, getShelves } from "../../../lib/kit";

export async function getStaticPaths() {
  const { categories } = await getShelves();
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const entries = (await getKit()).filter((entry) => entry.data.category === category.slug);
---

<Base title={category.name} description={category.intro}>
  <header class={`cat-hero tone-${category.tone}`}>
    <div class="container cat-hero-grid">
      <div class="cat-hero-copy">
        <p class="crumbs"><a href="/kit/">All kit</a></p>
        <span class="bento-icon"><Icon name={category.slug} /></span>
        <h1 class="page-hero-title">{category.name}</h1>
        <p class="page-hero-sub">{category.intro}</p>
        <p class="cat-hero-count">{entries.length} {entries.length === 1 ? "pick" : "picks"}</p>
      </div>
      <div class="cat-hero-art" aria-hidden="true">
        {entries.slice(0, 3).map((entry) => <ProductArt entry={entry} bare morph={false} />)}
      </div>
    </div>
  </header>
  <div class="container">
    <ul class="product-grid">
      {entries.map((entry) => <ProductCard entry={entry} showCategory={false} heading="h2" />)}
    </ul>
  </div>
  <div class="section-spacer" aria-hidden="true"></div>
</Base>
