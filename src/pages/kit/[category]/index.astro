---
import Base from "../../../layouts/Base.astro";
import ProductCard from "../../../components/ProductCard.astro";
import { getKit, getShelves } from "../../../lib/kit";

export async function getStaticPaths() {
  const { categories } = await getShelves();
  return categories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const entries = (await getKit()).filter((entry) => entry.data.category === category.slug);
---

<Base title={category.name} description={category.intro}>
  <header class={`page-hero tone-${category.tone}`}>
    <div class="container">
      <p class="crumbs"><a href="/kit/">All kit</a></p>
      <h1 class="page-hero-title">{category.name}.</h1>
      <p class="page-hero-sub">{category.intro}</p>
      <p class="page-hero-count">{entries.length} {entries.length === 1 ? "pick" : "picks"}</p>
    </div>
  </header>
  <div class="container">
    <ul class="product-grid">
      {entries.map((entry) => <ProductCard entry={entry} showCategory={false} heading="h2" />)}
    </ul>
  </div>
  <div class="section-spacer" aria-hidden="true"></div>
</Base>
