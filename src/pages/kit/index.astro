---
import Base from "../../layouts/Base.astro";
import ProductTile from "../../components/ProductTile.astro";
import { copy } from "../../config/active";
import { getShelves } from "../../lib/kit";

const { kit, categories, tags } = await getShelves();
---

<Base title={copy.kit.title} description={copy.kit.lead}>
  <header class="container page-head">
    <h1 class="page-title">{copy.kit.title}</h1>
    <p class="page-sub">{copy.kit.lead}</p>
  </header>

  <div class="container">
    <!-- Hidden until the script runs: with JavaScript off the full list shows and there are no dead buttons. -->
    <div class="filter" data-filter hidden>
      <fieldset>
        <legend>{copy.kit.filterCategory}</legend>
        <div class="pills">
          <button type="button" data-kind="category" data-value="" aria-pressed="true">{copy.kit.allCategories}</button>
          {
            categories.map((c) => (
              <button type="button" data-kind="category" data-value={c.slug} aria-pressed="false">
                {c.name}
              </button>
            ))
          }
        </div>
      </fieldset>
      <fieldset>
        <legend>{copy.kit.filterTag}</legend>
        <div class="pills">
          <button type="button" data-kind="tag" data-value="" aria-pressed="true">{copy.kit.allTags}</button>
          {
            tags.map((t) => (
              <button type="button" data-kind="tag" data-value={t.slug} aria-pressed="false">
                {t.name}
              </button>
            ))
          }
        </div>
      </fieldset>
    </div>

    {
      kit.length === 0 && (
        <div class="empty-state">
          <h2>{copy.home.emptyHeading}</h2>
          <p>{copy.home.empty}</p>
        </div>
      )
    }
    <p class="count" data-count aria-live="polite" hidden></p>
    <ul class="product-grid entries">
      {kit.map((entry) => <ProductTile entry={entry} />)}
    </ul>
    <div class="list-empty" data-empty hidden>
      <p>{copy.kit.empty}</p>
      <button type="button" class="button" data-clear>{copy.kit.clear}</button>
    </div>
  </div>
  <div class="section-spacer" aria-hidden="true"></div>
</Base>

<script>
  type Kind = "category" | "tag";

  const filter = document.querySelector<HTMLElement>("[data-filter]")!;
  const hasRows = document.querySelector(".entries [data-category]") !== null;
  const buttons = [...filter.querySelectorAll<HTMLButtonElement>("button[data-kind]")];
  const rows = [...document.querySelectorAll<HTMLElement>(".entries [data-category]")];
  const count = document.querySelector<HTMLElement>("[data-count]")!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  const state: Record<Kind, string> = { category: "", tag: "" };

  const known = (kind: Kind, value: string | null) =>
    value !== null && buttons.some((b) => b.dataset.kind === kind && b.dataset.value === value);

  function apply() {
    let shown = 0;
    for (const row of rows) {
      const match =
        (!state.category || row.dataset.category === state.category) &&
        (!state.tag || (row.dataset.tags ?? "").split(" ").includes(state.tag));
      row.hidden = !match;
      if (match) shown++;
    }
    for (const button of buttons) {
      button.setAttribute("aria-pressed", String(state[button.dataset.kind as Kind] === button.dataset.value));
    }
    count.textContent = shown === rows.length ? `${rows.length} picks` : `${shown} of ${rows.length} picks`;
    empty.hidden = shown > 0;
  }

  function write() {
    const params = new URLSearchParams();
    if (state.category) params.set("category", state.category);
    if (state.tag) params.set("tag", state.tag);
    const query = params.toString();
    history.replaceState(null, "", query ? `?${query}` : location.pathname);
  }

  const params = new URLSearchParams(location.search);
  for (const kind of ["category", "tag"] as const) {
    const value = params.get(kind);
    if (known(kind, value)) state[kind] = value!;
  }

  filter.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>("button[data-kind]");
    if (!button) return;
    state[button.dataset.kind as Kind] = button.dataset.value ?? "";
    apply();
    write();
  });

  empty.querySelector("[data-clear]")!.addEventListener("click", () => {
    state.category = "";
    state.tag = "";
    apply();
    write();
  });

  apply();
  // Nothing to filter until products are published.
  filter.hidden = !hasRows;
  count.hidden = !hasRows;
</script>
