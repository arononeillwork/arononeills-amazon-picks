---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProductArt from "../components/ProductArt.astro";
import ProductCard from "../components/ProductCard.astro";
import { categoryBySlug, copy, site } from "../config/active";
import { displayName, entryHref, getShelves, type Entry } from "../lib/kit";

const { kit, categories } = await getShelves();
const inCategory = (slug: string) => kit.filter((e) => e.data.category === slug);
// Most recently checked first; ties keep catalogue order.
const latest = kit
  .map((entry, index) => ({ entry, index }))
  .sort((a, b) => b.entry.data.reviewed.getTime() - a.entry.data.reviewed.getTime() || a.index - b.index)
  .map(({ entry }) => entry);
const spotlight = kit.find((e) => e.data.featured) ?? latest[0];

// The hero bento: five products, photos first, one per category where possible,
// leaving out the spotlight, which gets its own band further down.
const pool = [...latest.filter((e) => e.data.image), ...latest.filter((e) => !e.data.image)].filter((e) => e !== spotlight);
const bento: Entry[] = [];
for (const entry of pool) {
  if (bento.length < 5 && !bento.some((e) => e.data.category === entry.data.category)) bento.push(entry);
}
for (const entry of pool) {
  if (bento.length < 5 && !bento.includes(entry)) bento.push(entry);
}
// The spotlight band sits between the category shelves, after the second one.
const spotlightAfter = Math.min(1, categories.length - 1);
---

<Base>
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-head">
        <p class="hero-eyebrow">{copy.home.eyebrow}</p>
        <h1 class="hero-title">{copy.home.title}</h1>
        <p class="hero-lead">{copy.home.lead}</p>
        <div class="hero-ctas">
          {kit.length > 0 && <a class="button button-lg" href="#shop">{copy.home.cta}</a>}
          <a class="link-chevron" href="/disclosure/">{copy.home.secondary}</a>
        </div>
      </div>
      {
        bento.length >= 3 && (
          <ul class="bento" aria-label={copy.home.bentoLabel}>
            {bento.map((entry, index) => {
              const category = categoryBySlug(entry.data.category);
              return (
                <li class:list={["tile", `tone-${category.tone}`, { "tile-lead": index === 0 }]}>
                  <div class="tile-text">
                    <p class="tile-eyebrow">{entry.data.brand ?? category.name}</p>
                    <p class="tile-name">
                      <a class="tile-link" href={entryHref(entry)}>
                        {displayName(entry)}
                      </a>
                    </p>
                    {index === 0 && <p class="tile-sub">{entry.data.title}</p>}
                  </div>
                  <ProductArt
                    entry={entry}
                    bare
                    morph={false}
                    priority={index === 0}
                    sizes={index === 0 ? "(min-width: 900px) 560px, 92vw" : "(min-width: 900px) 270px, 46vw"}
                    class="tile-art"
                  />
                </li>
              );
            })}
          </ul>
        )
      }
      <ul class="trust" aria-label={copy.home.trustLabel}>
        {
          copy.home.promises.map((promise) => (
            <li>
              <Icon name="check" />
              {promise}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    kit.length === 0 ? (
      <section class="section">
        <div class="container">
          <div class="empty-state">
            <h2>{copy.home.emptyHeading}</h2>
            <p>{copy.home.empty}</p>
          </div>
        </div>
      </section>
    ) : (
      <div id="shop">
        {/* Sticky row of categories, like a store's local nav. Plain anchor links: no JavaScript. */}
        <nav class="catbar" aria-label={copy.home.jumpLabel}>
          <ul class="container">
            {categories.map((category) => (
              <li>
                <a class={`cat-chip tone-${category.tone}`} href={`#${category.slug}`}>
                  {category.name}
                </a>
              </li>
            ))}
            <li>
              <a class="cat-chip cat-all" href="/kit/">
                {copy.home.allKit}
              </a>
            </li>
          </ul>
        </nav>

        {categories.map((category, index) => {
          const entries = inCategory(category.slug);
          const tone = spotlight && categoryBySlug(spotlight.data.category).tone;
          return (
            <>
              <section class="shelf" id={category.slug} aria-labelledby={`${category.slug}-title`}>
                <div class="container shelf-head">
                  <div>
                    <h2 class="h2" id={`${category.slug}-title`}>
                      {category.name}.
                    </h2>
                    <p class="shelf-sub">{category.intro}</p>
                  </div>
                  {entries.length > 1 && (
                    <a class="link-chevron" href={`/kit/${category.slug}/`}>
                      {copy.home.seeAll} {entries.length}
                    </a>
                  )}
                </div>
                <ul class="container shelf-row">
                  {entries.map((entry) => (
                    <ProductCard entry={entry} showCategory={false} />
                  ))}
                </ul>
              </section>

              {index === spotlightAfter && spotlight && (
                <section class={`band tone-${tone}`} aria-labelledby="spotlight-title">
                  <div class="container band-grid">
                    <div class="band-art reveal">
                      <ProductArt entry={spotlight} bare morph={false} sizes="(min-width: 900px) 560px, 92vw" />
                    </div>
                    <div class="band-copy">
                      <p class="band-eyebrow">
                        <Icon name="sparkle" />
                        {copy.home.spotlight}
                        {spotlight.data.brand && <span>· {spotlight.data.brand}</span>}
                      </p>
                      <h2 class="band-title" id="spotlight-title">
                        {displayName(spotlight)}
                      </h2>
                      <p class="band-sub">{spotlight.data.title}</p>
                      {spotlight.data.highlights && (
                        <ul class="facts">
                          {spotlight.data.highlights.map((highlight) => (
                            <li>
                              <Icon name="check" />
                              {highlight}
                            </li>
                          ))}
                        </ul>
                      )}
                      <a class="button" href={entryHref(spotlight)}>
                        {copy.home.spotlightCta}
                      </a>
                    </div>
                  </div>
                </section>
              )}
            </>
          );
        })}
      </div>
    )
  }

  <section class="section why">
    <div class="container">
      <h2 class="h2 reveal">{copy.home.whyHeading} <span>{copy.home.whySub}</span></h2>
      <p class="why-about reveal">{site.owner.about}</p>
      <ul class="why-grid">
        {
          copy.home.why.map((point) => (
            <li class="reveal">
              <span class="why-icon">
                <Icon name={point.icon} />
              </span>
              <h3>{point.title}</h3>
              <p>{point.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
