---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProductTile from "../components/ProductTile.astro";
import { copy, site } from "../config/active";
import { getShelves } from "../lib/kit";

const { kit, categories } = await getShelves();
// One entry from each category, to give a first-time visitor a way in.
const featured = categories
  .map((category) => kit.find((entry) => entry.data.category === category.slug))
  .filter((entry) => entry !== undefined);
const counts = Object.fromEntries(
  categories.map((c) => [c.slug, kit.filter((e) => e.data.category === c.slug).length]),
);
---

<Base>
  <section class="hero">
    <div class="container narrow">
      <h1 class="display">{copy.home.title}</h1>
      <p class="hero-sub">{copy.home.lead}</p>
      <div class="cta-row">
        {kit.length > 0 && <a class="button" href="/kit/">{copy.home.cta}</a>}
        <a class="link-chevron" href="/disclosure/">{copy.home.secondary}</a>
      </div>
    </div>
  </section>

  {
    kit.length === 0 ? (
      <section class="section section-alt">
        <div class="container">
          <div class="empty-state">
            <h2>{copy.home.emptyHeading}</h2>
            <p>{copy.home.empty}</p>
          </div>
        </div>
      </section>
    ) : (
      <>
        <section class="section section-alt">
          <div class="container">
            <h2 class="section-title center">{copy.home.categoriesHeading}</h2>
            <ul class="category-grid">
              {categories.map((category) => (
                <li class="tile category-tile">
                  <Icon name={category.slug} />
                  <h3>
                    <a class="tile-link" href={`/kit/${category.slug}/`}>
                      {category.name}
                    </a>
                  </h3>
                  <p>{category.intro}</p>
                  <div class="tile-foot">
                    <span class="count-label">
                      {counts[category.slug]} {counts[category.slug] === 1 ? "pick" : "picks"}
                    </span>
                    <span class="link-chevron" aria-hidden="true">
                      {copy.home.explore}
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="section">
          <div class="container">
            <div class="section-head">
              <h2 class="section-title">{copy.home.featuredHeading}</h2>
              <a class="link-chevron" href="/kit/">
                {copy.home.allLink}
              </a>
            </div>
            <ul class="product-grid">
              {featured.map((entry) => (
                <ProductTile entry={entry} />
              ))}
            </ul>
          </div>
        </section>
      </>
    )
  }

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title center">{copy.home.whyHeading}</h2>
      <p class="section-sub center">{site.owner.about}</p>
      <ul class="points">
        {
          copy.home.why.map((point) => (
            <li>
              <Icon name={point.icon} />
              <h3>{point.title}</h3>
              <p>{point.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
