---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProductCard from "../components/ProductCard.astro";
import { copy, site } from "../config/active";
import { getShelves } from "../lib/kit";

const { kit, categories } = await getShelves();
const counts = Object.fromEntries(categories.map((c) => [c.slug, kit.filter((e) => e.data.category === c.slug).length]));
// Most recently checked first; ties keep catalogue order.
const latest = kit
  .map((entry, index) => ({ entry, index }))
  .sort((a, b) => b.entry.data.reviewed.getTime() - a.entry.data.reviewed.getTime() || a.index - b.index)
  .slice(0, 8)
  .map(({ entry }) => entry);
---

<Base>
  <section class="store-hero container">
    <h1 class="store-title">{copy.home.title} <span>{copy.home.lead}</span></h1>
    <a class="link-chevron" href="/disclosure/">{copy.home.secondary}</a>
  </section>

  {
    kit.length === 0 ? (
      <section class="section section-alt">
        <div class="container">
          <div class="empty-state">
            <h2>{copy.home.emptyHeading}</h2>
            <p>{copy.home.empty}</p>
          </div>
        </div>
      </section>
    ) : (
      <>
        <nav class="container cat-strip" aria-label={copy.home.categoriesLabel}>
          <ul>
            {categories.map((category) => (
              <li>
                <a class="cat-link" href={`/kit/${category.slug}/`}>
                  <span class={`cat-badge tone-${category.tone}`}>
                    <Icon name={category.slug} />
                  </span>
                  <span class="cat-name">{category.name}</span>
                  <span class="cat-count">
                    {counts[category.slug]} {counts[category.slug] === 1 ? "pick" : "picks"}
                  </span>
                </a>
              </li>
            ))}
            <li>
              <a class="cat-link" href="/kit/">
                <span class="cat-badge tone-grey">
                  <Icon name="grid" />
                </span>
                <span class="cat-name">{copy.home.allKit}</span>
                <span class="cat-count">{kit.length} picks</span>
              </a>
            </li>
          </ul>
        </nav>

        <section class="shelf">
          <div class="container shelf-head">
            <h2 class="shelf-title">
              {copy.home.latestHeading} <span>{copy.home.latestSub}</span>
            </h2>
            <a class="link-chevron" href="/kit/">
              {copy.home.allLink}
            </a>
          </div>
          <ul class="shelf-row">
            {latest.map((entry) => (
              <ProductCard entry={entry} />
            ))}
          </ul>
        </section>
      </>
    )
  }

  <section class="section section-alt">
    <div class="container">
      <h2 class="shelf-title">{copy.home.whyHeading} <span>{copy.home.whySub}</span></h2>
      <p class="why-about">{site.owner.about}</p>
      <ul class="why-grid">
        {
          copy.home.why.map((point) => (
            <li class="why-card">
              <Icon name={point.icon} />
              <h3>{point.title}</h3>
              <p>{point.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
