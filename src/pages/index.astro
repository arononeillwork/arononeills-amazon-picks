---
import Base from "../layouts/Base.astro";
import HeroCollection from "../components/HeroCollection.astro";
import Icon from "../components/Icon.astro";
import ProductArt from "../components/ProductArt.astro";
import ProductCard from "../components/ProductCard.astro";
import { activeProfile, categoryBySlug, copy, site } from "../config/active";
import { displayName, entryHref, getShelves } from "../lib/kit";

const { kit, categories } = await getShelves();
const inCategory = (slug: string) => kit.filter((e) => e.data.category === slug);
// Most recently checked first; ties keep catalogue order.
const latest = kit
  .map((entry, index) => ({ entry, index }))
  .sort((a, b) => b.entry.data.reviewed.getTime() - a.entry.data.reviewed.getTime() || a.index - b.index)
  .map(({ entry }) => entry);
const spotlight = kit.find((e) => e.data.featured) ?? latest[0];
// The spotlight band sits between the category shelves, after the second one.
const spotlightAfter = Math.min(1, categories.length - 1);

// The hero picture, made by `npm run hero` from hero.json in the profile.
// The preflight checks every product in it is published.
const heroDir = `../profiles/${activeProfile}/hero`;
const heroImages = import.meta.glob<{ default: ImageMetadata }>("../profiles/*/hero/collection-*.webp", { eager: true });
const heroConfigs = import.meta.glob<{ default: { layouts: { wide: { items: { slug: string }[] } } } }>("../profiles/*/hero/hero.json", {
  eager: true,
});
const wide = heroImages[`${heroDir}/collection-wide.webp`]?.default;
const square = heroImages[`${heroDir}/collection-square.webp`]?.default;
const shown = (heroConfigs[`${heroDir}/hero.json`]?.default.layouts.wide.items ?? []).flatMap(
  ({ slug }) => kit.find((e) => e.id === slug) ?? [],
);
const heroAlt = `${copy.home.collectionLabel}: ${shown.map((e) => [e.data.brand, displayName(e)].filter(Boolean).join(" ")).join(", ")}`;
const makers = [...new Set(shown.flatMap((e) => (e.data.imageCredit ? [e.data.imageCredit] : [])))];
const heroCredit = makers.length ? `${copy.home.photosBy} ${makers.join(", ")}` : undefined;
---

<Base>
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-head">
      <h1 class="hero-title">{copy.home.title}</h1>
      <p class="hero-lead">{copy.home.lead}</p>
      {kit.length > 0 && <a class="button button-lg" href="#shop">{copy.home.cta}</a>}
    </div>
    {wide && square && shown.length > 0 && <HeroCollection wide={wide} square={square} alt={heroAlt} credit={heroCredit} />}
  </section>

  {
    kit.length === 0 ? (
      <section class="section">
        <div class="container">
          <div class="empty-state">
            <h2>{copy.home.emptyHeading}</h2>
            <p>{copy.home.empty}</p>
          </div>
        </div>
      </section>
    ) : (
      <div id="shop">
        {/* Sticky row of categories, like a store's local nav. Plain anchor links: no JavaScript. */}
        <nav class="catbar" aria-label={copy.home.jumpLabel}>
          <ul class="container">
            {categories.map((category) => (
              <li>
                <a class={`cat-chip tone-${category.tone}`} href={`#${category.slug}`}>
                  {category.name}
                </a>
              </li>
            ))}
            <li>
              <a class="cat-chip cat-all" href="/kit/">
                {copy.home.allKit}
              </a>
            </li>
          </ul>
        </nav>

        {categories.map((category, index) => {
          const entries = inCategory(category.slug);
          const tone = spotlight && categoryBySlug(spotlight.data.category).tone;
          return (
            <>
              <section class="shelf" id={category.slug} aria-labelledby={`${category.slug}-title`}>
                <div class="container shelf-head">
                  <h2 class="h2" id={`${category.slug}-title`}>
                    {category.name}.
                  </h2>
                  {entries.length > 1 && (
                    <a class="link-chevron" href={`/kit/${category.slug}/`}>
                      {copy.home.seeAll} {entries.length}
                    </a>
                  )}
                </div>
                <ul class="container shelf-row">
                  {entries.map((entry) => (
                    <ProductCard entry={entry} showCategory={false} sub={false} />
                  ))}
                </ul>
              </section>

              {index === spotlightAfter && spotlight && (
                <section class={`band tone-${tone}`} aria-labelledby="spotlight-title">
                  <div class="container band-grid">
                    <div class="band-art reveal">
                      <ProductArt entry={spotlight} bare morph={false} sizes="(min-width: 900px) 560px, 92vw" />
                    </div>
                    <div class="band-copy">
                      <p class="band-eyebrow">
                        <Icon name="sparkle" />
                        {copy.home.spotlight}
                        {spotlight.data.brand && <span>· {spotlight.data.brand}</span>}
                      </p>
                      <h2 class="band-title" id="spotlight-title">
                        {displayName(spotlight)}
                      </h2>
                      <p class="band-sub">{spotlight.data.title}</p>
                      <a class="button" href={entryHref(spotlight)}>
                        {copy.home.spotlightCta}
                      </a>
                    </div>
                  </div>
                </section>
              )}
            </>
          );
        })}
      </div>
    )
  }

  <section class="section why">
    <div class="container">
      <h2 class="h2 reveal">{copy.home.whyHeading} <span>{copy.home.whySub}</span></h2>
      <p class="why-about reveal">{site.owner.about}</p>
      <ul class="why-grid">
        {
          copy.home.why.map((point) => (
            <li class="reveal">
              <span class="why-icon">
                <Icon name={point.icon} />
              </span>
              <h3>{point.title}</h3>
              <p>{point.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
