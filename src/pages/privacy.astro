---
import Base from "../layouts/Base.astro";
import { copy, site } from "../config/active";

const { legal } = site;
// The calendar section describes Supabase processing, so it only appears while the calendar exists.
const sections = [...copy.privacy.sections];
if (site.features.apartment) sections.splice(sections.length - 1, 0, copy.privacy.calendar);
---

<Base title={copy.privacy.title}>
  <div class="container narrow prose-page">
    <h1 class="page-title">{copy.privacy.title}</h1>
    <p class="lead">{copy.privacy.lead}</p>

    <h2>{copy.privacy.controllerHeading}</h2>
    <p>{copy.privacy.controllerLead}</p>
    <address class="controller" data-controller>
      <dl>
        <dt>Name</dt>
        <dd>{legal.legalName}</dd>
        <dt>NIF</dt>
        <dd>{legal.nif}</dd>
        <dt>{legal.registry ? "Registered address" : "Address"}</dt>
        <dd>{legal.address}</dd>
        {
          legal.registry && (
            <>
              <dt>Registration</dt>
              <dd>{legal.registry}</dd>
            </>
          )
        }
        <dt>Email</dt>
        <dd><a href={`mailto:${legal.email}`}>{legal.email}</a></dd>
        <dt>Website</dt>
        <dd>{site.identity.url}</dd>
      </dl>
    </address>

    {
      sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </section>
      ))
    }
  </div>
</Base>
