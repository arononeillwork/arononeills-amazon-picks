---
import Base from "../layouts/Base.astro";
import { copy, site } from "../config/active";

const sections = [
  ...(site.affiliate.enabled ? copy.disclosure.affiliateOn : copy.disclosure.affiliateOff),
  ...copy.disclosure.always,
];
---

<Base title={copy.disclosure.title}>
  <div class="prose">
    <h1>{copy.disclosure.title}</h1>
    {
      site.affiliate.enabled && (
        <div class="note">
          {site.affiliate.sitewideStatement.map((statement) => (
            <p>{statement}</p>
          ))}
        </div>
      )
    }
    {
      sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </section>
      ))
    }
  </div>
</Base>
