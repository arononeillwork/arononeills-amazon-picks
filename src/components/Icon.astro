---
// Line icons in the spirit of SF Symbols, drawn inline so they cost no requests
// and follow the text colour. Categories map to an icon by slug; anything
// unknown gets the generic one.
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "icon" } = Astro.props;

const paths: Record<string, string> = {
  // On your feet: a trainer.
  "on-your-feet":
    '<path d="M3 16.5c0-1.1.9-2 2-2h2.2l2.3-5.6a1 1 0 0 1 1.3-.5l2.7 1.2-.8 2.1 2.1.9.8-2.1 1.9.8c1.5.7 2.5 2.2 2.5 3.8v1.4a1.5 1.5 0 0 1-1.5 1.5h-14A1.5 1.5 0 0 1 3 16.5Z"/><path d="M3.2 15.6h17.6"/><path d="M11.1 11.3l1.6.7M10.4 13l1.6.7"/>',
  // Recovery: a moon, for the evening after a shift.
  recovery: '<path d="M20 14.2A8 8 0 1 1 9.8 4a6.5 6.5 0 0 0 10.2 10.2Z"/><path d="M17.5 3.5v3M16 5h3"/>',
  // Carry and charge: a backpack.
  carry:
    '<path d="M6 9.5a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4V19a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 19Z"/><path d="M9.5 5.6V4.5a2.5 2.5 0 0 1 5 0v1.1"/><path d="M9 13h6v4H9Z"/>',
  // At home: a house.
  "at-home": '<path d="M4 11.2 12 4.5l8 6.7"/><path d="M6 9.6V19a1 1 0 0 0 1 1h3.5v-5h3v5H17a1 1 0 0 0 1-1V9.6"/>',
  // Out in the sun: a sun.
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.8v2M12 19.2v2M2.8 12h2M19.2 12h2M5.5 5.5l1.4 1.4M17.1 17.1l1.4 1.4M18.5 5.5l-1.4 1.4M6.9 17.1l-1.4 1.4"/>',
  // Owned or researched: a checkmark in a circle.
  check: '<circle cx="12" cy="12" r="8.5"/><path d="M8.3 12.3l2.5 2.4 4.9-5"/>',
  // Honest drawback: a balance.
  balance: '<path d="M12 4v16M7 20h10M5 7h14"/><path d="M5 7l-2.5 6a2.5 2.5 0 0 0 5 0Z"/><path d="M19 7l-2.5 6a2.5 2.5 0 0 0 5 0Z"/>',
  // Straight to Amazon.es: an arrow leaving a box.
  arrow: '<path d="M14 4h6v6M20 4l-8.5 8.5"/><path d="M18 13.5V18a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4.5"/>',
  // Everything: four tiles.
  grid: '<rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/>',
  // Go: a chevron.
  chevron: '<path d="M9.5 6l6 6-6 6"/>',
  // Sparkle, for the spotlight.
  sparkle: '<path d="M12 3.5l1.7 5.1a2 2 0 0 0 1.3 1.3l5.1 1.6-5.1 1.7a2 2 0 0 0-1.3 1.3L12 19.5l-1.7-5a2 2 0 0 0-1.3-1.3l-5.1-1.7 5.1-1.6a2 2 0 0 0 1.3-1.3Z"/>',
  // Anything else: a tag.
  default: '<path d="M4 12.6V5.5A1.5 1.5 0 0 1 5.5 4h7.1l7.4 7.4a1.5 1.5 0 0 1 0 2.1l-6.5 6.5a1.5 1.5 0 0 1-2.1 0Z"/><circle cx="8.5" cy="8.5" r="1.3"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name] ?? paths.default}
/>
