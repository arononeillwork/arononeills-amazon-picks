---
// Multi-option entries (the laptop): one affiliate block per pick, each with
// its own disclosure line directly above its link.
import BuyBlock from "./BuyBlock.astro";
import { copy } from "../config/active";
import type { Entry } from "../lib/kit";

interface Props {
  picks: NonNullable<Entry["data"]["picks"]>;
}

const { picks } = Astro.props;
---

<section class="picks" id="picks" aria-labelledby="picks-heading">
  <h2 id="picks-heading" class="shelf-title">{copy.entry.picksHeading}</h2>
  <div class="picks-grid">
    {
      picks.map((pick) => (
        <BuyBlock asin={pick.asin} product={pick.product} class="pick-card">
          <p class="pick-label">{pick.label}</p>
          <h3 class="pick-product">{pick.product}</h3>
          <p class="pick-why">{pick.why}</p>
        </BuyBlock>
      ))
    }
  </div>
</section>
