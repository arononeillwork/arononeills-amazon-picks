---
import "../styles/global.css";
import inter from "../assets/fonts/inter-latin-wght-normal.woff2?url";
import { site } from "../config/active";
import { TONES } from "../config/schema";
import { themeCss } from "../config/theme";
import { getShelves } from "../lib/kit";

interface Props {
  /** Page title without the masthead. Omit on the home page. */
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
}

const { title, description = site.identity.description, noindex = false, ogType = "website" } = Astro.props;
const fullTitle = title ? `${title} · ${site.identity.masthead}` : `${site.identity.masthead}: ${site.identity.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;

const { categories } = await getShelves();
const nav = [
  { href: "/kit/", label: "All kit" },
  ...categories.map((c) => ({ href: `/kit/${c.slug}/`, label: c.name })),
];

// Prefetch without shipping JavaScript. The apartment and admin are excluded
// because prerendering them would start sign-in checks in the background.
const speculationRules = {
  prerender: [
    {
      where: {
        and: [
          { href_matches: "/*" },
          { not: { href_matches: "/apartment/*" } },
          { not: { href_matches: "/admin/*" } },
          { not: { href_matches: "/api/*" } },
        ],
      },
      eagerness: "moderate",
    },
  ],
};

// Shading for the product drawings (components/art.ts): one set of gradients
// per category tone, referenced from global.css, plus a blur for their shadows.
const shades = ["a", "ad", "s"] as const;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={site.identity.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? site.identity.masthead} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.identity.masthead} />
    <meta property="og:locale" content={site.identity.locale} />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={site.palette.dark.bg} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={themeCss(site.palette)}></style>
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)}></script>
  </head>
  <body>
    <svg class="art-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="g-b" x1="0" y1="0" x2="1" y2="1"><stop offset="0" class="st-b1"></stop><stop offset="1" class="st-b2"></stop></linearGradient>
        <linearGradient id="g-k" x1="0" y1="0" x2="1" y2="1"><stop offset="0" class="st-k1"></stop><stop offset="1" class="st-k2"></stop></linearGradient>
        {
          TONES.map((tone) =>
            shades.map((shade) => (
              <linearGradient id={`g-${shade}-${tone}`} class={`tone-${tone}`} x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" class={`st-${shade}1`} />
                <stop offset="1" class={`st-${shade}2`} />
              </linearGradient>
            )),
          )
        }
        <filter id="f-soft" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="7"></feGaussianBlur></filter>
      </defs>
    </svg>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>{site.identity.masthead}</a>
        <nav class="nav-links" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-top">
          <a class="brand brand-footer" href="/"><span class="brand-mark" aria-hidden="true"></span>{site.identity.masthead}</a>
          <p>{site.identity.tagline}.</p>
        </div>
        {
          site.affiliate.enabled && (
            <div class="footer-disclosure" data-sitewide-disclosure>
              {site.affiliate.sitewideStatement.map((statement) => (
                <p>{statement}</p>
              ))}
            </div>
          )
        }
        <div class="footer-bottom">
          <p>Copyright © {year} {site.owner.name}.</p>
          <ul>
            <li><a href="/kit/">All kit</a></li>
            <li><a href="/disclosure/">How this site is paid for</a></li>
            <li><a href="/privacy/">Privacy and legal notice</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
